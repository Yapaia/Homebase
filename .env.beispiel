# ─── Yapaia Homebase ────────────────────────────────────────────────────────
# Kopieren nach .env und ausfüllen:  cp .env.beispiel .env

# Die Domain der Webseite. Ihr DNS-Eintrag (A/AAAA) muss auf den VPS zeigen.
# Leer lassen = nur HTTP auf Port 80 über die IP (zum ersten Ausprobieren).
SEITE_DOMAIN=

# www.<domain> auf <domain> umleiten (braucht ebenfalls einen DNS-Eintrag).
SEITE_WWW=nein

# Optional: Domain des Kartenservers. Die Homebase holt dafür das Zertifikat
# und leitet an den Kartenserver auf diesem VPS weiter (KARTEN_ZIEL).
KARTEN_DOMAIN=
KARTEN_ZIEL=127.0.0.1:8080

# Welches Design alle sehen, die keins gewählt haben: horizont, kompass, logbuch
STANDARD_DESIGN=horizont

# 1 = Umschalt-Leiste für die Designs unten auf jeder Seite. 0 = aus (später,
# wenn das Design feststeht).
VORSCHAU=1

# Optional: E-Mail für Hinweise von Let's Encrypt (z. B. ablaufende Zertifikate).
ACME_EMAIL=
